# -----------------------------------------------------------------------------
# 安全警告：请勿使用默认密码进行部署
# 对于非本地部署，请将所有密码（ELASTIC_PASSWORD、MYSQL_PASSWORD、
# MINIO_PASSWORD 等）修改为高强度且互不相同的值。
# 可使用以下命令生成随机字符串：openssl rand -hex 32
# -----------------------------------------------------------------------------

# 此部署仅支持使用 Elasticsearch 作为文档引擎。
DOC_ENGINE=elasticsearch

# Elasticsearch 版本。
STACK_VERSION=${STACK_VERSION:-8.11.3}

# Elasticsearch 服务的主机名。
ES_HOST=es01

# Elasticsearch 服务暴露到宿主机的端口，
# 用于从 Docker 容器外部访问该服务。
ES_PORT=1200

# Elasticsearch 密码。
# 警告：生产环境必须修改此密码！
ELASTIC_PASSWORD=infini_rag_flow

# Kibana 服务暴露到宿主机的端口，
# 用于从 Docker 容器外部访问该服务。
# 使用 `--profile kibana` 启用。
KIBANA_PORT=6601
KIBANA_PASSWORD=infini_rag_flow

# 单个 Docker 容器运行时允许使用的最大内存，单位为字节。
# 请根据宿主机的可用内存进行调整。
MEM_LIMIT=8073741824

# MySQL 密码。
# 警告：生产环境必须修改此密码！
MYSQL_PASSWORD=infini_rag_flow
# MySQL 服务的主机名。
MYSQL_HOST=mysql
# 使用的 MySQL 数据库名称。
MYSQL_DBNAME=rag_flow
# RAGFlow 容器连接 MySQL 使用的端口。
# 使用外部 MySQL 时请按实际情况修改。
MYSQL_PORT=3306
# MySQL 服务暴露到宿主机的端口，
# 用于从 Docker 容器外部访问 MySQL 数据库。
EXPOSE_MYSQL_PORT=3306
# 发送到 MySQL 服务器的通信数据包最大大小。
MYSQL_MAX_PACKET=1073741824

# MinIO 服务的主机名。
MINIO_HOST=minio
# MinIO 控制台暴露到宿主机的端口，
# 用于从 Docker 容器外部访问 Web 控制台。
MINIO_CONSOLE_PORT=9001
# MinIO API 服务暴露到宿主机的端口，
# 用于从 Docker 容器外部访问对象存储服务。
MINIO_PORT=9000
# MinIO 用户名。
# 修改后，必须同步修改 service_conf.yaml 中的 `minio.user`。
MINIO_USER=rag_flow
# MinIO 密码。
# 修改后，必须同步修改 service_conf.yaml 中的 `minio.password`。
MINIO_PASSWORD=infini_rag_flow

# Redis 服务的主机名。
REDIS_HOST=redis
# Redis 服务暴露到宿主机的端口，
# 用于从 Docker 容器外部访问该服务。
REDIS_PORT=6379
# Redis 密码。
REDIS_PASSWORD=infini_rag_flow

# RAGFlow HTTP API 服务暴露到宿主机的端口，
# 用于从 Docker 容器外部访问该服务。
SVR_WEB_HTTP_PORT=80
SVR_WEB_HTTPS_PORT=443
SVR_HTTP_PORT=9380
ADMIN_SVR_HTTP_PORT=9381
SVR_MCP_PORT=9382

# 仅用于开发环境：设置为 1 时跳过 test_db_connection 的主机安全检查，
# 允许访问私有或本地数据库主机。请勿在生产环境启用。
ALLOW_ANY_HOST=0

# docker/manage.sh 按以下格式生成默认镜像名称：
# ragflow-local:<pyproject-version>.<7-character-git-hash>.
# 取消下一行注释可覆盖该带版本号的镜像名称。
# RAGFLOW_IMAGE=registry.example.com/ragflow:custom-tag

# 最终镜像构建使用的 build base 镜像。
# RAGFLOW_BUILD_BASE_IMAGE=ghcr.io/example/ragflow-build-base:latest

# 镜像构建使用的可选内部软件源。
# UBUNTU_MIRROR=http://apt.internal/ubuntu
# PYPI_INDEX_URL=http://pypi.internal/repository/pypi/simple
# NPM_REGISTRY=http://npm.internal/repository/npm-group

# 直接启动 docker-compose.local.yml 时使用的镜像。
# RAGFLOW_LOCAL_IMAGE=ragflow-local:dev

# 浏览器标题和面向用户显示的产品名称。
# APP_NAME=RAGFlow

# 产品图标和浏览器 favicon，支持相对路径和 HTTP(S) URL。
# APP_ICON_URL=/logo.svg

# 初始超级管理员。仅在首次部署时取消以下变量的注释，
# 并同时启用 --init-superuser 启动参数。
# DEFAULT_SUPERUSER_NICKNAME=admin
# DEFAULT_SUPERUSER_EMAIL=admin@ragflow.io
# DEFAULT_SUPERUSER_PASSWORD=admin

# 如果无法下载 RAGFlow Docker 镜像，可使用以下镜像地址：
# RAGFLOW_IMAGE=swr.cn-north-4.myhuaweicloud.com/infiniflow/ragflow:v0.26.4
# RAGFLOW_IMAGE=registry.cn-hangzhou.aliyuncs.com/infiniflow/ragflow:v0.26.4
#
# 使用 `nightly` 版本时，可取消以下任一配置的注释：
# RAGFLOW_IMAGE=swr.cn-north-4.myhuaweicloud.com/infiniflow/ragflow:nightly
# RAGFLOW_IMAGE=registry.cn-hangzhou.aliyuncs.com/infiniflow/ragflow:nightly

# 本地时区。
TZ=Asia/Shanghai

# 如果访问 huggingface.co 受限，可取消下一行的注释：
# HF_ENDPOINT=https://hf-mirror.com

# 向知识库或 RAGFlow 文件系统单次上传文件的最大大小，单位为字节。
# 当前上限为 2 GiB，可按需修改以下配置。
MAX_CONTENT_LENGTH=2147483648
# 修改后，请同步更新 nginx/nginx.conf 中的 `client_max_body_size`。
# 注意：`MAX_CONTENT_LENGTH` 和 `client_max_body_size` 均不限制上传到智能体的文件大小。
# 详情请参阅 https://ragflow.io/docs/dev/begin_component。

# 控制单批处理的文档数量。
# 未显式设置 DOC_BULK_SIZE 时默认为 4。
DOC_BULK_SIZE=${DOC_BULK_SIZE:-4}

# 定义生成嵌入向量时单批处理的项目数量。
# 环境中未设置 EMBEDDING_BATCH_SIZE 时默认为 16。
EMBEDDING_BATCH_SIZE=${EMBEDDING_BATCH_SIZE:-16}

# RAGFlow 自身及其导入依赖包的日志级别。
# 可用级别：
# - `DEBUG`
# - `INFO`（默认）
# - `WARNING`
# - `ERROR`
# 示例：以下配置将 `ragflow.es_conn` 的日志级别调整为 `DEBUG`：
# LOG_LEVELS=ragflow.es_conn=DEBUG

# 阿里云 OSS 配置。
# STORAGE_IMPL=OSS
# ACCESS_KEY=xxx
# SECRET_KEY=eee
# ENDPOINT=http://oss-cn-hangzhou.aliyuncs.com
# REGION=cn-hangzhou
# BUCKET=ragflow65536
#

# 用户注册开关：
# - 启用注册：1
# - 禁用注册：0
REGISTER_ENABLED=1

# -----------------------------------------------------------------------------
# 沙箱
# -----------------------------------------------------------------------------
# 沙箱提供商类型和运行时参数在“管理后台 > 沙箱设置”中配置。

# 启用沙箱支持。
# SANDBOX_ENABLED=1
# 使用 `--profile sandbox` 启动 Compose。

# 沙箱通用配置。
# 用于存储沙箱生成文件的 MinIO 存储桶名称。
# SANDBOX_ARTIFACT_BUCKET=sandbox-artifacts

# 沙箱生成文件自动删除前的保留天数。
# SANDBOX_ARTIFACT_EXPIRE_DAYS=7

# 自托管部署默认配置。
# 以下值由 `sandbox` Compose profile 使用，并在管理后台中作为
# 自托管提供商的部署默认值显示。
# 运行前请拉取所需的基础镜像：
#   docker pull infiniflow/sandbox-base-nodejs:latest
#   docker pull infiniflow/sandbox-base-python:latest
# 默认运行时镜像包含：
# - Node.js 基础镜像：axios
# - Python 基础镜像：requests、numpy、pandas
# SANDBOX_EXECUTOR_MANAGER_IMAGE=${SANDBOX_EXECUTOR_MANAGER_IMAGE:-infiniflow/sandbox-executor-manager:latest}
# SANDBOX_EXECUTOR_MANAGER_POOL_SIZE=${SANDBOX_EXECUTOR_MANAGER_POOL_SIZE:-3}
# SANDBOX_BASE_PYTHON_IMAGE=${SANDBOX_BASE_PYTHON_IMAGE:-infiniflow/sandbox-base-python:latest}
# SANDBOX_BASE_NODEJS_IMAGE=${SANDBOX_BASE_NODEJS_IMAGE:-infiniflow/sandbox-base-nodejs:latest}
# SANDBOX_EXECUTOR_MANAGER_PORT=${SANDBOX_EXECUTOR_MANAGER_PORT:-9385}
# SANDBOX_ENABLE_SECCOMP=false
# SANDBOX_MAX_MEMORY=256m # b, k, m, g
# SANDBOX_TIMEOUT=10s # s, m, 1m30s
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# SANDBOX_EXECUTOR_MANAGER_API_TOKEN=
# SANDBOX_EXECUTOR_MANAGER_ALLOW_UNAUTHENTICATED=false
# SANDBOX_CONTAINER_NETWORK=none
# SANDBOX_RUN_PREAUTH_RATE_LIMIT=30/minute
# SANDBOX_RUN_RATE_LIMIT=120/minute

# -----------------------------------------------------------------------------
# 沙箱配置结束
# -----------------------------------------------------------------------------

# 启用 DocLing。
USE_DOCLING=false

# 启用 MinerU。
# 取消以下配置的注释后，系统会尽可能自动将 MinerU 添加到模型提供商中。
# 详情请参阅 https://ragflow.io/docs/faq#how-to-use-mineru-to-parse-pdf-documents。
# MINERU_DELETE_OUTPUT=0   # 保留输出目录
# MINERU_BACKEND=pipeline  # 或使用其他所需后端
# MINERU_HEALTHCHECK_TIMEOUT=30  # OpenAPI 可用性检查超时，单位为秒

# PPTX 支持。
DOTNET_SYSTEM_GLOBALIZATION_INVARIANT=1

# 加密工具配置。
# RAGFLOW_CRYPTO_ENABLED=true
# RAGFLOW_CRYPTO_ALGORITHM=aes-256-cbc # 可选值：aes-256-cbc、aes-128-cbc、sm4-cbc
# RAGFLOW_CRYPTO_KEY=ragflow-crypto-key


# ThreadPoolExecutor 使用的最大工作线程数。
THREAD_POOL_MAX_WORKERS=128

# 是否为 SSO 禁用密码登录表单。
DISABLE_PASSWORD_LOGIN=false

# 可选的 OA 登录配置。
OA_ENABLED=false
OA_DISPLAY_NAME=OA
OA_ICON=sso
OA_CLIENT_ID=
OA_CLIENT_SECRET=
OA_AUTHORIZATION_URL=
OA_TOKEN_URL=
OA_USERINFO_URL=
OA_REDIRECT_URI=
OA_SCOPE=api
OA_REQUEST_TIMEOUT=30
